# Copy to backend/.env (or export in your shell) before running in production.
# The defaults below are safe for local development only.

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-not-a-secret-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=0

# SQLite location inside the backend container; omit for backend/db.sqlite3.
# SQLITE_PATH=/data/db.sqlite3

# Comma-separated browser origins allowed to call the API directly.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Redis cache (LocMemCache is used when unset).
REDIS_URL=redis://localhost:6379/1

# Celery / async analysis jobs
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=1

# PostgreSQL (leave unset for SQLite)
# DATABASE_URL=postgres://spotter:spotter@localhost:5432/spotter
POSTGRES_DB=spotter
POSTGRES_USER=spotter
POSTGRES_PASSWORD=spotter

# Free provider endpoints. No API keys are required.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com
PROVIDER_USER_AGENT=SpotterRouteSafety/1.0 (weather-aware route assessment demo)

HTTP_TIMEOUT_SECONDS=25
OPEN_METEO_BATCH_SIZE=40
WEATHER_FETCH_CONCURRENCY=6
RISK_POLICY_VERSION=2026-11-a

API_THROTTLE_ANON=120/min
API_THROTTLE_USER=600/min
API_THROTTLE_ANALYSIS=12/min
API_THROTTLE_PLACES=60/min

# Frontend (Vite) build-time API base. Defaults to /api/v1 (proxied).
# VITE_API_BASE=https://your-api.example.com/api/v1
